PORT=3000

# Required for JWT signing (login tokens). Use a long random string in production.
JWT_SECRET=your-secret-here

# Optional: Datomic Local (set for persistent storage and to query same DB from REPL)
# DATOMIC_STORAGE_DIR=/path/to/datomic-data
# DATOMIC_DB_NAME=loan-market
# DATOMIC_SYSTEM=dev
